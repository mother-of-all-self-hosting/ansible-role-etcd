TZ={{ etcd_environment_variables_tz }}

ETCD_NAME={{ etcd_environment_variable_etcd_name }}

{# etcd defaults its data directory to a relative path below its working #}
{# directory, which the container's read-only root filesystem makes #}
{# unwritable, so this is not optional. #}
ETCD_DATA_DIR={{ etcd_container_data_dir_path }}

ETCD_ENABLE_V2={{ etcd_environment_variable_etcd_enable_v2 | to_json }}

ETCD_LOG_LEVEL={{ etcd_environment_variable_etcd_log_level }}

ETCD_ADVERTISE_CLIENT_URLS={{ etcd_environment_variable_etcd_advertise_client_urls }}
ETCD_LISTEN_CLIENT_URLS={{ etcd_environment_variable_etcd_listen_client_urls }}

ETCD_ROOT_PASSWORD={{ etcd_environment_variable_etcd_root_password }}
ALLOW_NONE_AUTHENTICATION={{ 'yes' if etcd_environment_variable_allow_none_authentication else 'no' }}

{{ etcd_environment_variables_additional_variables }}
